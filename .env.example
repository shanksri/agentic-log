# development (default) or production. Production additionally requires
# API_KEY to be a real secret and DATABASE_URL to not point at
# localhost/127.0.0.1 — Settings() raises at startup otherwise (Phase 24A).
# Production also disables /docs, /redoc, and /openapi.json.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/incidents
GITHUB_TOKEN=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
# Shared secret for Bearer API-key auth (Phase 23B). Required in any
# deployed environment — generate with e.g. `openssl rand -hex 32`.
# Never commit a real value here.
API_KEY=changeme-generate-a-real-secret

# Opt-in adaptive Dense/BM25/Hybrid retrieval routing (Phase 18). false
# preserves dense-only behavior exactly.
SEARCH_ROUTING_ENABLED=false

# Endpoint-aware rate limiting (Phase 23C). Global kill switch, then one
# requests-per-60s-window limit per endpoint-cost group. See README's
# "Rate limiting" section for what each group covers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH_PER_MINUTE=100
RATE_LIMIT_AGENT_PER_MINUTE=20
RATE_LIMIT_EVALUATION_QUERY_PER_MINUTE=20
RATE_LIMIT_EVALUATION_RETRIEVAL_PER_MINUTE=5
RATE_LIMIT_EVALUATION_REASONING_PER_MINUTE=5
RATE_LIMIT_EVALUATION_FULL_PER_MINUTE=2
RATE_LIMIT_INTERACTIVE_EVALUATION_PER_MINUTE=20
RATE_LIMIT_INCIDENTS_PER_MINUTE=100
RATE_LIMIT_INGESTION_PER_MINUTE=10
RATE_LIMIT_EVALUATION_RUNS_PER_MINUTE=60
